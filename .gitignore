# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android
android/local.properties
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
*.jks
*.keystore
# Deliberately committed: a stable, non-secret debug-only signing key
# (standard Android debug credentials) so every CI build shares one
# certificate and can be installed as an update over the last, instead
# of every release needing a full uninstall/reinstall. Never used for
# release/Play Store signing.
!android/app/debug.keystore

# IDE
.idea/
*.iml
.vscode/

# The actual model weights are large binaries downloaded at setup time,
# never committed to the repo.
assets/models/*.gguf

# macOS
.DS_Store
